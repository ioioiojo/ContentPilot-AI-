# Local development, never upload a file containing real credentials.
DATABASE_URL=sqlite:///./data/contentpilot.db
APP_ENV=development
COOKIE_SECURE=false
ALLOWED_HOSTS=localhost,127.0.0.1
CONTENTPILOT_PROVIDER=mock
CONTENTPILOT_TOOLS=mcp
JOB_TIMEOUT_SECONDS=180
JOB_MAX_ATTEMPTS=1
MAX_ACTIVE_JOBS=10
DAILY_JOBS=50
MAX_ACTIVE_MEDIA=5
DAILY_MEDIA=20
SUBMISSIONS_ENABLED=true
# Optional override; otherwise encrypted settings use data/service-config.key.
CONTENTPILOT_CONFIG_KEY=
# Optional TikHub Xiaohongshu data service or search gateway (see deployment/REFERENCE_SEARCH.md).
CONTENTPILOT_SEARCH_XIAOHONGSHU_PROVIDER=auto
TIKHUB_API_KEY=
CONTENTPILOT_SEARCH_XIAOHONGSHU_URL=
CONTENTPILOT_SEARCH_XIAOHONGSHU_TOKEN=
# Explicitly select compatible only when ready to use a real model.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=qwen-plus
# Optional integrations. Leave blank until the provider and account are authorized.
CONTENTPILOT_IMAGE_BASE_URL=
CONTENTPILOT_IMAGE_API_KEY=
CONTENTPILOT_IMAGE_MODEL=
CONTENTPILOT_VIDEO_URL=
CONTENTPILOT_VIDEO_TOKEN=
CONTENTPILOT_PUBLISH_XIAOHONGSHU_URL=
CONTENTPILOT_PUBLISH_XIAOHONGSHU_TOKEN=
CONTENTPILOT_PUBLISH_DOUYIN_URL=
CONTENTPILOT_PUBLISH_DOUYIN_TOKEN=
CONTENTPILOT_PUBLISH_WECHAT_URL=
CONTENTPILOT_PUBLISH_WECHAT_TOKEN=
