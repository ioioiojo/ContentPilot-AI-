# Adapt this as a NEW HTTPS virtual host, alongside the existing website.
# Replace the domain and certificate paths before nginx -t.
server {
    listen 443 ssl;
    server_name contentpilot.example.com;
    ssl_certificate /etc/letsencrypt/live/contentpilot.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/contentpilot.example.com/privkey.pem;

    client_max_body_size 256k;
    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 30s;
    }
}
